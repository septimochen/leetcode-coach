LEETCODE_USERNAME=your_leetcode_username
# Defaults to OpenAI. For another OpenAI-compatible provider, set its `/v1` URL.
LLM_API_KEY=your_provider_api_key
LLM_BASE_URL=
# Public data may work without these. Keep them local if you need authenticated data.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=
LLM_MODEL=gpt-5-mini
OUTPUT_DIR=data/plans

# Storage: local writes to OUTPUT_DIR; s3 uses the S3-compatible settings below.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# Email delivery is disabled locally by default. Gmail requires an App Password.
EMAIL_ENABLED=false
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL (default: INFO).
# Overridden by --log-level. Credential values are replaced with *** in every line.
LOG_LEVEL=INFO
# Optional: also append records to a file (overridden by --log-file).
# Handy for cron, where stdout is easy to lose:
# LOG_FILE=logs/leetcode-coach.log
